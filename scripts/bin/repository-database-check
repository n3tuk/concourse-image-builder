#!/usr/bin/env bash
# vim:set ft=bash:

set -euo pipefail

exec 3>&1 # make stdout available as fd 3 for the result
exec 1>&2 # redirect all output to stderr for logging

LIB_DIR=$(realpath "$(dirname "${0}")/../lib")
export LIB_DIR

# shellcheck source=../lib/common.sh
source "${LIB_DIR}/common.sh"
# shellcheck source=../lib/payload.sh
source "${LIB_DIR}/payload.sh"
# shellcheck source=../lib/database.sh
source "${LIB_DIR}/database.sh"

log:info "Initiating Arch Linux repository database check"

check:commands aws jq logger mktemp uuidgen

# If this source is disabled, return an empty array to indicate no versions
if [[ "$(payload:source disable false false)" == "true" ]]; then
  echo "[]" >&3
  exit 0
fi

region=$(payload:source region true weur)
endpoint=$(payload:source endpoint)
bucket=$(payload:source bucket)
prefix=$(payload:source prefix)
repository=$(payload:source repository)

access_key_id=$(payload:source access_key_id true "" true)
export AWS_ACCESS_KEY_ID="${access_key_id}"
secret_access_key=$(payload:source secret_access_key true "" true)
export AWS_SECRET_ACCESS_KEY="${secret_access_key}"

if ! database:exists "${region}" "${endpoint}" "${bucket}" "${prefix}" "${repository}"; then
  echo "[]" >&3
  log:fatal "Repository database does not exist" bucket="${bucket}" repository="${prefix}/${repository}"
fi

etag=$(database:etag "${region}" "${endpoint}" "${bucket}" "${prefix}" "${repository}")

log:info "Repository database checked" bucket="${bucket}" repository="${prefix}/${repository}" etag="${etag}"

# Output a version with the entity tag of the database file to indicate the current version of the repository database,
# and trigger a run if a new tag for the database is available (which usually means there are packages to clean up). By
# only returning the current tag, we let Concourse decide when a new version has been retrieved and processed.
jq --monochrome-output --compact-output --null-input --arg "etag" "${etag}" '[{"etag":$etag}]' >&3
