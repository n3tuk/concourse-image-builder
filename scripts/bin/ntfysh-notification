#!/usr/bin/env bash
# vim:set ft=bash:

set -euo pipefail

exec 3>&1 # make stdout available as fd 3 for the result
exec 1>&2 # redirect all output to stderr for logging

LIB_DIR=$(realpath "$(dirname "${0}")/../lib")
export LIB_DIR

# shellcheck source=../lib/common.sh
source "${LIB_DIR}/common.sh"
# shellcheck source=../lib/ntfysh.sh
source "${LIB_DIR}/ntfysh.sh"

cd "${1}"

payload=$(cat <&0)
timestamp=$(jq --null-input --arg "timestamp" "$(date +%s)" '{version:{timestamp:$timestamp}}')

disable="$(jq --raw-output '.source.disable' <<< "${payload}")"
if [[ ${disable} == "true" ]]; then
    echo "${timestamp}" >&3
    exit 0
fi

