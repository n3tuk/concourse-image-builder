#!/usr/bin/env bash
# vim:set ft=bash:

set -euo pipefail

LIB_DIR=$(realpath "$(dirname "${0}")/../lib")
export LIB_DIR

# shellcheck source=../lib/common.sh
source "${LIB_DIR}/common.sh"
# shellcheck source=../lib/database.sh
source "${LIB_DIR}/database.sh"

log:info "Initiating Arch Linux repository cleanup"

check:commands aws jq logger mktemp uuidgen

check:variables endpoint region bucket prefix repository
check:variables access_key_id:sensitive secret_access_key:sensitive

export AWS_ACCESS_KEY_ID="${access_key_id:-}"
export AWS_SECRET_ACCESS_KEY="${secret_access_key:-}"

resource="repository-database"
referenced=$(mktemp)
present=$(mktemp)

if ! database:extract "${resource}" "${repository}"; then
  log:fatal "Failed to extract the repository database" resource="${resource}" database="${repository}.db.tar.gz"
fi

log:info "Reading the package database" resource="${resource}" database="${repository}.db.tar.gz"

# The database contains one directory per package, named "<pkgname>-<version>"; record the referenced package filename
# for each entry so we can compare it to the list of package files present in the bucket.
for desc in "${resource}"/db/*/desc; do
  test -f "${desc}" || continue
  awk '/^%FILENAME%$/{getline; print}' "${desc}" >> "${referenced}"
done

log:info "Listing all known packages" bucket="${bucket}" prefix="${prefix}" repository="${repository}"

aws s3 --region "${region}" --endpoint-url "${endpoint}" ls "s3://${bucket}/${prefix}/" --recursive \
| awk '{print $4}' \
| grep -E '\.pkg\.tar\.zst$' > "${present}" || true

# Before removing any packages, check that all active packages referenced by the database are present in the bucket. If
# any are missing, fail the cleanup and log a fatal error. This is a safety check to ensure that we do use an historical
# version of the database that references packages that have already been removed from the bucket, which in turn can
# remove newer versions of the same package that are still referenced by current version of the database.
missing=0
while IFS= read -r package; do
  test -n "${package}" || continue

  log:debug "Checking for package" bucket="${bucket}" prefix="${prefix}" repository="${repository}" package="${package}"

  if grep -qxF "${prefix}/${package}" "${present}"; then
    continue
  fi

  log:warning "Active package not found in bucket" bucket="${bucket}" prefix="${prefix}" repository="${repository}" package="${package}"
  missing=1
done < "${referenced}"

if test "${missing}" -gt 0; then
  log:fatal "One or more active packages referenced by the database are missing from the bucket" bucket="${bucket}" prefix="${prefix}" repository="${repository}" missing="${missing}"
fi

log:info "All active packages referenced by the database are present in the bucket" bucket="${bucket}" prefix="${prefix}" repository="${repository}" missing="${missing}"

# For each package file present in the bucket that is NOT the version referenced by the database, remove it and its
# signature. The database is the source of truth for the current version, so anything it does not reference is an older
# version safe to delete.
removed=0
while IFS= read -r package; do
  test -n "${package}" || continue
  filename="$(basename "${package}")"

  if grep -qxF "${filename}" "${referenced}"; then
    continue
  fi

  log:info "Removing unreferenced package" bucket="${bucket}" prefix="${prefix}" repository="${repository}" package="${package}"
  if ! aws s3 --region "${region}" --endpoint-url "${endpoint}" rm "s3://${bucket}/${package}"; then
    log:warning "Failed to remove package" bucket="${bucket}" prefix="${prefix}" repository="${repository}" package="${package}"
  else
    aws s3 --region "${region}" --endpoint-url "${endpoint}" rm "s3://${bucket}/${package}.sig" || true
    removed=$((removed + 1))
  fi
done < "${present}"

log:info "Cleanup complete" bucket="${bucket}" prefix="${prefix}" repository="${repository}" missing="${missing}" removed="${removed:-0}"
