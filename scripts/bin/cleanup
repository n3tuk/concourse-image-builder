#!/usr/bin/env bash
# vim:set ft=bash:

set -euo pipefail

LIB_DIR=$(realpath "$(dirname "${0}")/../lib")
export LIB_DIR

# shellcheck source=../lib/common.sh
source "${LIB_DIR}/common.sh"
# shellcheck source=../lib/database.sh
source "${LIB_DIR}/database.sh"
# shellcheck source=../lib/cleanup.sh
source "${LIB_DIR}/cleanup.sh"

log:info "Initiating Arch Linux repository cleanup"

check:commands aws jq logger mktemp uuidgen

# If this source is disabled, return an empty array to indicate no versions
if [[ "$(payload:source disable false)" == "true" ]]; then
  echo "[]" >&3
  exit 0
fi

check:variables ENDPOINT REGION BUCKET PREFIX REPOSITORY
check:variables ACCESS_KEY_ID:sensitive SECRET_ACCESS_KEY:sensitive

export AWS_ACCESS_KEY_ID="${ACCESS_KEY_ID}"
export AWS_SECRET_ACCESS_KEY="${SECRET_ACCESS_KEY}"

if ! database:extract "${REPOSITORY}"; then
  log:fatal "Failed to extract the repository database" database="${REPOSITORY}.db.tar.gz"
fi

referenced=$(mktemp)
present=$(mktemp)

log:info "Reading the package database" database="${REPOSITORY}.db.tar.gz"

# The database contains one directory per package, named "<pkgname>-<version>"; record the referenced package filename
# for each entry so we can compare it to the list of package files present in the bucket.
for desc in db/*/desc; do
  test -f "${desc}" || continue
  awk '/^%FILENAME%$/{getline; print}' "${desc}" >> "${referenced}"
done

log:info "Requesting all repository packages in the bucket" bucket="${BUCKET}" prefix="${PREFIX}" repository="${REPOSITORY}"

aws s3 --region "${REGION}" --endpoint-url "${ENDPOINT}" ls "s3://${BUCKET}/${PREFIX}/" --recursive \
| awk '{print $4}' \
| grep -E '\.pkg\.tar\.zst$' > "${present}" || true

# For each package file present in the bucket that is NOT the version referenced by the database, remove it and its
# signature. The database is the source of truth for the current version, so anything it does not reference is an older
# version safe to delete.
removed=0
while IFS= read -r object; do
  [ -n "${object}" ] || continue

  filename="$(basename "${object}")"
  if grep -qxF "${filename}" "${referenced}"; then
    log:debug "Skipping active package" bucket="${BUCKET}" prefix="${PREFIX}" repository="${REPOSITORY}" package="${object}"
    continue
  fi

  if ! aws s3 --region "${REGION}" --endpoint-url "${ENDPOINT}" rm "s3://${BUCKET}/${object}"; then
    log:warning "Failed to remove package" bucket="${BUCKET}" prefix="${PREFIX}" repository="${REPOSITORY}" package="${object}"
  else
    aws s3 --region "${REGION}" --endpoint-url "${ENDPOINT}" rm "s3://${BUCKET}/${object}.sig" || true
    log:info "Removing unreferenced package" bucket="${BUCKET}" prefix="${PREFIX}" repository="${REPOSITORY}" package="${object}"
  fi
  removed=$((removed + 1))
done < "${present}"

log:info "Cleanup complete" bucket="${BUCKET}" prefix="${PREFIX}" repository="${REPOSITORY}" removed="${removed:-0}"
